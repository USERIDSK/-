LANGUAGE LANG_CHINESE, SUBLANG_CHINESE_SIMPLIFIED
STRINGTABLE
BEGIN
    IDS_WINDOW_TITLE            "音视频批量转换与编辑工具"
    IDS_QUEUE_LABEL             "待转换队列:"
    IDS_FILTER_LABEL            "按格式:"
    IDS_OUTPUT_DIR_LABEL        "输出目录:"
    IDS_OUTPUT_FORMAT_LABEL     "输出格式:"
    IDS_PRESET_LABEL            "编码预设:"
    IDS_CRF_LABEL               "画质(CRF):"
    IDS_RESOLUTION_LABEL        "分辨率:"
    IDS_FPS_LABEL               "帧率(FPS):"
    IDS_AUDIO_BITRATE_LABEL     "音频码率:"
    IDS_AUDIO_RATE_LABEL        "采样率:"
    IDS_CHANNELS_LABEL          "声道:"
    IDS_VOLUME_LABEL            "音量倍数:"
    IDS_BRIGHTNESS_LABEL        "亮度(-1~1):"
    IDS_CONTRAST_LABEL          "对比度(0~3):"
    IDS_SATURATION_LABEL        "饱和度(0~3):"
    IDS_SHARPEN_LABEL           "锐化(0~5):"
    IDS_SPEED_LABEL             "倍速:"
    IDS_START_TIME_LABEL        "起始时间:"
    IDS_DURATION_LABEL          "持续时长:"

    IDS_BTN_ADD_FILES           "添加文件"
    IDS_BTN_ADD_FOLDER          "添加文件夹"
    IDS_BTN_REMOVE              "移除选中"
    IDS_BTN_CLEAR               "清空列表"
    IDS_BTN_FILTER              "过滤并全选"
    IDS_BTN_SELECT_OUTPUT       "选择输出目录"
    IDS_BTN_OPEN_OUTPUT         "打开输出目录"
    IDS_BTN_START               "开始转换"

    IDS_PRESET_MEDIUM           "medium(默认)"
    IDS_PRESET_FAST             "fast(快速)"
    IDS_PRESET_SLOW             "slow(慢速)"

    IDS_CRF_HIGH                "18(高画质)"
    IDS_CRF_BALANCED            "23(均衡)"
    IDS_CRF_COMPRESS            "28(压缩优先)"

    IDS_RES_KEEP                "保持原样"
    IDS_RES_1080P               "1920x1080"
    IDS_RES_720P                "1280x720"
    IDS_RES_480P                "854x480"

    IDS_FPS_KEEP                "保持原样"
    IDS_FPS_60                  "60"
    IDS_FPS_30                  "30"
    IDS_FPS_24                  "24"

    IDS_ABR_AUTO                "默认/自动"
    IDS_ABR_320                 "320 kbps"
    IDS_ABR_192                 "192 kbps"
    IDS_ABR_128                 "128 kbps"

    IDS_AR_KEEP                 "保持原样"
    IDS_AR_48000                "48000 Hz"
    IDS_AR_44100                "44100 Hz"

    IDS_CH_KEEP                 "保持原样"
    IDS_CH_STEREO               "立体声(2)"
    IDS_CH_MONO                 "单声道(1)"

    IDS_FMT_MP4                 "MP4 (视频)"
    IDS_FMT_MKV                 "MKV (视频)"
    IDS_FMT_AVI                 "AVI (视频)"
    IDS_FMT_MP3                 "MP3 (音频)"
    IDS_FMT_WAV                 "WAV (音频)"
    IDS_FMT_AAC                 "AAC (音频)"
    IDS_FMT_FLAC                "FLAC (音频)"
    IDS_FMT_COPY_SUFFIX         " (仅换容器)"

    IDS_STATUS_READY            "状态：就绪"
    IDS_STATUS_FILES_ADDED      "状态：文件已加入队列"
    IDS_STATUS_LIST_CLEARED     "状态：列表已清空"
    IDS_STATUS_CONVERTING       "状态：正在批量转换..."
    IDS_STATUS_COPY_CONVERTING  "状态：仅换容器转换中..."
    IDS_STATUS_DONE             "状态：批量转换完成！"
    IDS_STATUS_DONE_FAIL        "状态：完成，失败 %d 个"
    IDS_STATUS_FILTERED         "状态：已过滤出 %d 个 %s 文件"
    IDS_STATUS_SCANNING         "状态：正在扫描文件夹..."

    IDS_MSG_FFMPEG_MISSING      "未找到 ffmpeg.exe！\n\n已尝试查找：\n  1) 程序同目录\n  2) 系统 PATH\n\n请把 ffmpeg.exe 放到程序目录下再试。"
    IDS_MSG_QUEUE_EMPTY         "待转换队列为空！"
    IDS_MSG_NO_OUTPUT_DIR       "请选择输出目录！"
    IDS_MSG_NO_FORMAT           "请选择输出格式！"
    IDS_MSG_SCAN_DONE           "扫描完成！\n本次新增 %d 个文件。\n当前队列共 %d 个。"
    IDS_MSG_SCAN_EMPTY          "未找到支持的音视频文件。"
    IDS_MSG_FILTER_EMPTY        "当前列表中没有可过滤的格式！"
    IDS_MSG_FILTER_NOTHING      "过滤后没有剩余文件！"
    IDS_MSG_CONVERT_DONE        "批量转换完成！\n成功: %d / %d"
    IDS_MSG_WARN_TITLE          "警告"
    IDS_MSG_ERROR_TITLE         "错误"
    IDS_MSG_DONE_TITLE          "完成"
    IDS_MSG_TIP_TITLE           "提示"
    IDS_MSG_FFMPEG_WARN         "警告：未找到 ffmpeg.exe！\n\n程序会在下面两个位置查找：\n  1) 程序同目录\n  2) 系统 PATH\n\n请下载 ffmpeg 并放到程序目录下。"
    IDS_MSG_BUSY                "正在转换中，请稍候..."
    IDS_MSG_NO_OUTPUT_FILES     "还没有输出目录。"

    IDS_DLG_PICK_FOLDER         "请选择包含音视频的文件夹"
    IDS_DLG_PICK_OUTPUT         "请选择输出文件夹"
    IDS_DLG_FILTER_ALL          "所有文件"
    IDS_DLG_FILTER_VIDEO        "视频文件"
    IDS_DLG_FILTER_AUDIO        "音频文件"
END

